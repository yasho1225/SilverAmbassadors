# Public site origin used for sitemap/metadata (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Public Google Calendar embed URL (iframe src). Leave empty to show the placeholder state.
# Example: https://calendar.google.com/calendar/embed?src=YOUR_CALENDAR_ID&ctz=America%2FNew_York
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=

# Optional direct link to open the calendar in Google Calendar
NEXT_PUBLIC_GOOGLE_CALENDAR_URL=

# Verified club social links. Leave empty until club leadership supplies them.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GROUPME_URL=
